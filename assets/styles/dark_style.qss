/* ============================================
   DARK STYLE — version finale
   Fond unifié #2c3e50 / surfaces #34495e
   ============================================ */

QMainWindow {
    background-color: #2c3e50;
    color: #ecf0f1;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

QWidget {
    color: #ecf0f1;
    font-family: "Segoe UI", sans-serif;
}

QLabel {
    color: #ecf0f1;
    background: transparent;
}

/* --- Menu --- */
QMenuBar {
    background-color: #34495e;
    color: #ecf0f1;
    border-bottom: 1px solid #4a5f7f;
    padding: 4px;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #1abc9c;
    color: #2c3e50;
}
QMenu {
    background-color: #34495e;
    border: 1px solid #4a5f7f;
    color: #ecf0f1;
    padding: 4px;
}
QMenu::item {
    padding: 8px 30px 8px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #1abc9c;
    color: #2c3e50;
}
QMenu::separator {
    height: 1px;
    background: #4a5f7f;
    margin: 4px 8px;
}

/* --- Toolbar / Status --- */
QToolBar {
    background-color: #34495e;
    border: none;
    border-bottom: 1px solid #4a5f7f;
    spacing: 4px;
    padding: 4px;
}
QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: #ecf0f1;
}
QToolButton:hover { background-color: #4a5f7f; }
QToolButton:pressed { background-color: #1abc9c; }

QStatusBar {
    background-color: #34495e;
    color: #ecf0f1;
    font-weight: 600;
    padding: 4px 8px;
    border-top: 1px solid #4a5f7f;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #4a5f7f;
    background: #2c3e50;
    border-radius: 6px;
}
QTabBar::tab {
    background: #34495e;
    color: #ecf0f1;
    padding: 10px 20px;
    border: 1px solid #4a5f7f;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
    font-weight: 600;
}
QTabBar::tab:hover { background-color: #4a5f7f; }
QTabBar::tab:selected {
    background: #2c3e50;
    border-color: #1abc9c;
    color: #1abc9c;
    font-weight: 800;
}

/* --- Boutons --- */
QPushButton {
    background-color: #1abc9c;
    color: white;
    border-radius: 6px;
    padding: 10px 16px;
    font-weight: 700;
    border: none;
    min-width: 90px;
}
QPushButton:hover { background-color: #16a085; }
QPushButton:pressed { background-color: #13876b; }
QPushButton:disabled {
    background-color: #4a5f7f;
    color: #95a5a6;
}

/* --- Inputs --- */
QLineEdit {
    background-color: #34495e;
    color: #ecf0f1;
    border: 1.5px solid #4a5f7f;
    border-radius: 6px;
    padding: 8px 12px;
}
QLineEdit:focus {
    border: 2px solid #1abc9c;
    background-color: #3b5770;
}

QTextEdit, QPlainTextEdit {
    background-color: #34495e;
    border: 1.5px solid #4a5f7f;
    border-radius: 6px;
    padding: 8px;
    color: #ecf0f1;
    selection-background-color: #1abc9c;
    selection-color: #2c3e50;
}

/* --- Checkbox (compact) --- */
QCheckBox {
    color: #ecf0f1;
    font-size: 13px;
    font-weight: 600;
    spacing: 6px;
    padding: 2px 4px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 2px solid #7f8c8d;
    background-color: #2c3e50;
}
QCheckBox::indicator:hover {
    border-color: #1abc9c;
}
QCheckBox::indicator:checked {
    background-color: #1abc9c;
    border-color: #1abc9c;
    image: url(assets/icons/check_green.svg);
}

/* --- Radio (petite boule) --- */
QRadioButton {
    color: #ecf0f1;
    font-size: 13px;
    font-weight: 600;
    spacing: 6px;
    padding: 2px 4px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid #7f8c8d;
    background-color: #2c3e50;
}
QRadioButton::indicator:hover {
    border-color: #1abc9c;
}
QRadioButton::indicator:checked {
    background-color: #1abc9c;
    border-color: #1abc9c;
    image: url(assets/icons/radio_green.svg);
}

/* --- Combo + popup --- */
QComboBox {
    background-color: #34495e;
    border: 1.5px solid #4a5f7f;
    border-radius: 8px;
    padding: 8px 32px 8px 12px;
    color: #ecf0f1;
    min-height: 32px;
    font-size: 14px;
}
QComboBox:hover { border-color: #1abc9c; }
QComboBox:focus {
    border-color: #1abc9c;
    background-color: #3b5770;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    border-left: 1px solid #4a5f7f;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(assets/icons/arrow_down_green.svg);
}
QComboBox QAbstractItemView {
    background-color: #34495e;
    border: 1px solid #4a5f7f;
    border-radius: 6px;
    selection-background-color: #1abc9c;
    selection-color: #2c3e50;
    color: #ecf0f1;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
    color: #ecf0f1;
    background-color: #34495e;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #1abc9c;
    color: #2c3e50;
}

QListView {
    background-color: #34495e;
    color: #ecf0f1;
    border: 1px solid #4a5f7f;
    outline: none;
}
QListView::item {
    color: #ecf0f1;
    background-color: #34495e;
    padding: 6px 10px;
    min-height: 28px;
}
QListView::item:hover,
QListView::item:selected {
    background-color: #1abc9c;
    color: #2c3e50;
}

/* --- SpinBox --- */
QSpinBox, QDoubleSpinBox {
    background-color: #34495e;
    border: 1.5px solid #4a5f7f;
    border-radius: 5px;
    padding: 6px;
    color: #ecf0f1;
}
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #1abc9c; }

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: #34495e;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1abc9c;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #16a085; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: #34495e;
    height: 12px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #1abc9c;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

/* --- Tables --- */
QTableWidget, QTableView {
    background-color: #34495e;
    alternate-background-color: #2c3e50;
    gridline-color: #4a5f7f;
    border: 1px solid #4a5f7f;
    border-radius: 5px;
    selection-background-color: #1abc9c;
    selection-color: #2c3e50;
    color: #ecf0f1;
}
QTableWidget::item, QTableView::item {
    padding: 5px;
    color: #ecf0f1;
}
QHeaderView::section {
    background-color: #4a5f7f;
    color: #ecf0f1;
    padding: 8px;
    border: none;
    font-weight: bold;
    border-bottom: 1px solid #5a6f8f;
}
QHeaderView::section:hover { background-color: #5a6f8f; }

/* --- GroupBox --- */
QGroupBox {
    background-color: transparent;
    border: 1px solid #4a5f7f;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: bold;
    color: #ecf0f1;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1abc9c;
}

/* --- Progress / Tooltip / MessageBox --- */
QProgressBar {
    background-color: #34495e;
    border: 1px solid #4a5f7f;
    border-radius: 5px;
    text-align: center;
    color: #ecf0f1;
    font-weight: bold;
}
QProgressBar::chunk {
    background-color: #1abc9c;
    border-radius: 3px;
}

QToolTip {
    background-color: #1abc9c;
    color: #2c3e50;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 13px;
    border: 1px solid #16a085;
}

QMessageBox {
    background-color: #2c3e50;
    color: #ecf0f1;
}
QMessageBox QLabel { color: #ecf0f1; }
QMessageBox QPushButton { min-width: 80px; }


/* ---  pour la view file --- */

QPushButton[variant="outline"] {
    background: transparent;
    border: 2px solid #1abc9c;
    color: #1abc9c;
}
QPushButton[variant="outline"]:hover {
    background: rgba(26, 188, 156, 0.15);
}